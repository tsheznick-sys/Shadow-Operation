[
  {
    "name": "WF1 Research",
    "nodes": [
      {
        "parameters": {
          "content": "### WF1 — Research\nMon 08:00 EAT. Reads the GREEN pool, asks the brain to rank it, writes the top five.\n\n**Requires:** `JARVIS_BRAIN_URL` and `N8N_BRAIN_TOKEN` in n8n → Settings → Variables.\nIf the brain answers 503 the workflow stops. It never substitutes text.",
          "height": 260,
          "width": 420,
          "color": 4
        },
        "id": "3110fdc7-3202-5e95-93c3-280005d4feaf",
        "name": "README",
        "type": "n8n-nodes-base.stickyNote",
        "typeVersion": 1,
        "position": [
          -380,
          0
        ]
      },
      {
        "parameters": {
          "rule": {
            "interval": [
              {
                "field": "cronExpression",
                "expression": "0 8 * * 1"
              }
            ]
          }
        },
        "id": "893e84d1-dc2e-5433-97ef-84766820ae5f",
        "name": "Mon 08:00",
        "type": "n8n-nodes-base.scheduleTrigger",
        "typeVersion": 1.1,
        "position": [
          0,
          0
        ]
      },
      {
        "parameters": {
          "operation": "executeQuery",
          "query": "SELECT handle, platform, followers, avg_comments, buyer_pool_x3, ratio, er FROM creators WHERE gate = 'GREEN' ORDER BY buyer_pool_x3 * er DESC LIMIT 50",
          "options": {}
        },
        "id": "836e3c3f-3a71-5e9c-89b2-5ad7688eb43c",
        "name": "GREEN pool",
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.4,
        "position": [
          220,
          0
        ],
        "credentials": {
          "postgres": {
            "id": "REPLACE_POSTGRES",
            "name": "Neon (jarvis)"
          }
        }
      },
      {
        "parameters": {
          "jsCode": "const rows = $input.all().map(r => r.json);\nif (rows.length === 0) { throw new Error('no GREEN creators — refusing to rank an empty pool'); }\nconst table = rows.map((r, i) => `${i + 1}. ${r.handle} (${r.platform}) followers=${r.followers} comments=${r.avg_comments} pool_x3=${r.buyer_pool_x3} ratio=${r.ratio} er=${r.er}`).join('\\n');\nconst prompt = [\n  'Rank these creators by how monetizable their audience is for a stickman faceless video agent at Circle $44 / Pro $53 / Team $62.',\n  'GREEN = ratio < 50:1 and ER >= 5%. Return strict JSON: {\"top5\":[{\"handle\":\"...\",\"why\":\"one sentence\"}]}. No prose outside the JSON.',\n  table,\n].join('\\n');\nreturn [{ json: { prompt, count: rows.length } }];"
        },
        "id": "0dc2eb39-d9e1-58c2-a1ed-c11e22a0311e",
        "name": "Build prompt",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          440,
          0
        ]
      },
      {
        "parameters": {
          "method": "POST",
          "url": "={{ $vars.JARVIS_BRAIN_URL }}/api/brain",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              {
                "name": "Authorization",
                "value": "=Bearer {{ $vars.N8N_BRAIN_TOKEN }}"
              },
              {
                "name": "content-type",
                "value": "application/json"
              }
            ]
          },
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={{ JSON.stringify({ prompt: prompt, expect: \"rank\", schema: {\"type\":\"object\",\"properties\":{\"top5\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"handle\":{\"type\":\"string\"},\"why\":{\"type\":\"string\"}},\"required\":[\"handle\",\"why\"]}}},\"required\":[\"top5\"]} }) }}",
          "options": {
            "timeout": 45000
          }
        },
        "id": "bbc3feea-3fd3-5658-8c9d-9efc2de6c74d",
        "name": "Ask brain (rank)",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          660,
          0
        ]
      },
      {
        "parameters": {
          "conditions": {
            "options": {
              "caseSensitive": true,
              "leftValue": "",
              "typeValidation": "loose"
            },
            "conditions": [
              {
                "id": "ok",
                "leftValue": "={{ $json.ok }}",
                "rightValue": "",
                "operator": {
                  "type": "boolean",
                  "operation": "true",
                  "singleValue": true
                }
              }
            ],
            "combinator": "and"
          },
          "options": {}
        },
        "id": "623435bb-c76d-5b9c-85e6-625ab30f1a99",
        "name": "Brain ok?",
        "type": "n8n-nodes-base.if",
        "typeVersion": 2,
        "position": [
          880,
          0
        ]
      },
      {
        "parameters": {
          "jsCode": "const body = $input.first().json;\n// Structured output: the app already parsed the JSON for us.\nif (body.parsed && Array.isArray(body.parsed.top5)) {\n  return body.parsed.top5.map(t => ({ json: { handle: t.handle, why: t.why || '', provider: body.provider, model: body.model } }));\n}\n// Fallback: the provider ignored the schema and returned prose. Recover it, and if\n// it cannot be recovered, throw rather than writing garbage to Postgres.\nconst text = body.data || '';\nconst start = text.indexOf('{');\nconst end = text.lastIndexOf('}');\nif (start === -1 || end === -1) throw new Error('brain reply was not JSON: ' + text.slice(0, 200));\nconst parsed = JSON.parse(text.slice(start, end + 1));\nconst top5 = Array.isArray(parsed.top5) ? parsed.top5 : [];\nif (top5.length === 0) throw new Error('brain returned an empty top5');\nreturn top5.map(t => ({ json: { handle: t.handle, why: t.why || '', provider: body.provider || null, model: body.model || null } }));"
        },
        "id": "2062563f-3861-51f5-be2b-f1e7cce66b2f",
        "name": "Parse top5",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1100,
          -60
        ]
      },
