/**
 * SHADOW OPERATOR WAVE SENDER — hardened rewrite of "Wave Autopilot v4.4"
 * ======================================================================
 *
 * WHY THIS REWRITE EXISTS
 * -----------------------
 * v4.4 installs a 24/7 hourly trigger firing 12 drafts/hour (288/day) from the
 * primary inbox through three hard-coded 50-recipient waves, plus a fallback
 * that sends ANY other draft in the account. Run against this repo's data it
 * would have:
 *
 *   - re-pitched 50/50 Wave-3 recipients, emailed 1-2 days earlier, who did
 *     not reply (spam-complaint engine);
 *   - cold-emailed both live positive leads mid-conversation;
 *   - emailed 10 recipients in the Motivation/Wealth niche, banned from
 *     scouting in reference/learnings.md (#15/15, 37/100);
 *   - run at 288/day against prompts/02's 20-30/day/inbox ceiling;
 *   - done it while VERDICT.md's kill criterion was TRIGGERED at 2/130.
 *
 * Gate it first:
 *   python tools/audit_wave_lists.py --waves <lists.json> \
 *          --sent-export <gmail-export.csv> --suppression-out suppression.csv
 *
 * WHAT CHANGED (every default below is the safe one)
 * --------------------------------------------------
 *   1. SENDING IS OFF. DRY_RUN = true. It stages and reports; it does not send.
 *   2. No auto-send trigger by default. installTrigger_() is opt-in and refuses
 *      to run while DRY_RUN is true or while the kill criterion is triggere.
 *   3. Suppression list is loaded and enforced. Generated by the audit tool.
 *   4. Hard daily cap (25) and hard per-run cap (10), both from prompts/02.
 *   5. Business-hours window only. Nothing goes out at 3am; a human answers
 *      replies within the 1-hour SLA in prompts/02.
 *   6. NO FALLBACK. A draft not on an explicit allowlist is never touched.
 *      v4.4's fallback would have sent personal and superseded drafts.
 *   7. Live threads are blocked by address, so a lead mid-conversation can
 *      never receive a fresh cold email.
 *   8. Quota guard keeps a reserve and stops at the first send error rather
 *      than continuing to hammer.
 *   9. clearExistingTriggers_() is no longer called blindly — v4.4 deleted
 *      every trigger in the project, including unrelated ones.
 *
 * SETUP
 * -----
 *   1. Paste SUPPRESSION_CSV below (or read it from a Drive file).
 *   2. Set KILL_CRITERION_TRIGGERED from `python tools/leak_finder.py brief`.
 *   3. Run previewRun(). Read the log. Only then set DRY_RUN = false.
 */

var CONFIG = {
  // ---- SAFETY DEFAULTS -------------------------------------------------
  DRY_RUN: true,                 // true = stage and report, never send
  KILL_CRITERION_TRIGGERED: true, // from tools/leak_finder.py brief
  REQUIRE_HUMAN_CONFIRM: true,   // must be set false deliberately to arm

  // ---- VOLUME (prompts/02: 20-30/day/inbox) ---------------------------
  MAX_PER_RUN: 10,
  MAX_PER_DAY: 25,
  MIN_QUOTA_RESERVE: 25,         // keep headroom for real conversations

  // ---- TIMING ----------------------------------------------------------
  TIMEZONE: 'Africa/Nairobi',
  SEND_WINDOW_START_HOUR: 9,     // EAT
  SEND_WINDOW_END_HOUR: 18,      // EAT — replies get answered within SLA
  MIN_SLEEP_MS: 45000,           // seconds-scale pacing, not 2-4s; volume is
  MAX_SLEEP_MS: 120000,          // the signal, not the inter-message gap

  // ---- LABELS ----------------------------------------------------------
  STAGED_LABEL: 'SOA/Wave-Staged',
  SENT_LABEL: 'SOA/Wave-Sent',

  // ---- SUPPRESSION -----------------------------------------------------
  // Replace with the output of:
  //   python tools/audit_wave_lists.py --waves <lists.json> \
  //          --sent-export <export.csv> --suppression-out suppression.csv
  // Columns: email,reason
  SUPPRESSION_CSV: 'email,reason\n',

  // Addresses in a live conversation — never send a cold email to these.
  LIVE_THREAD_EMAILS: [
    'ainewscentral@gmail.com',
    'premiereprotutos@gmail.com'
  ]
};

// Explicit allowlist. A draft not named here is never touched, by design.
// Populate AFTER `tools/audit_wave_lists.py` reports CLEAR.
var WAVES = {
  'Wave-Example': [
    // 'brandnew1@creator.com',
    // 'brandnew2@creator.com'
  ]
};


function previewRun() {
  return executeWave_(CONFIG.MAX_PER_RUN, /*dryOverride*/ true);
}

function sendRun() {
  var gate = preflight_();
  if (!gate.ok) {
    log_('BLOCKED: ' + gate.reason);
    return { sentCount: 0, blocked: gate.reason };
  }
  return executeWave_(CONFIG.MAX_PER_RUN, false);
}

/**
 * Opt-in trigger. Refuses to install while any safety default is armed, so the
 * trigger can never be the thing that turns sending on.
 */
function installTrigger_() {
  if (CONFIG.DRY_RUN || CONFIG.REQUIRE_HUMAN_CONFIRM || CONFIG.KILL_CRITERION_TRIGGERED) {
    log_('REFUSING to install: set DRY_RUN=false, REQUIRE_HUMAN_CONFIRM=false and ' +
         'KILL_CRITERION_TRIGGERED=false only after `tools/audit_wave_lists.py` is CLEAR ' +
         'and `tools/leak_finder.py brief` shows the criterion clear.');
    return false;
  }
  ScriptApp.newTrigger('sendRun').timeBased().everyHours(1).create();
  log_('Trigger installed at ' + CONFIG.MAX_PER_RUN + '/run, ' +
       CONFIG.MAX_PER_DAY + '/day, ' + CONFIG.SEND_WINDOW_START_HOUR + ':00-' +
       CONFIG.SEND_WINDOW_END_HOUR + ':00 EAT only.');
  return true;
}

function preflight_() {
  if (CONFIG.DRY_RUN && !arguments.length) {
    // dry runs are always allowed; live sends are gated below
  }
  if (CONFIG.KILL_CRITERION_TRIGGERED) {
    return { ok: false, reason: 'VERDICT.md kill criterion is TRIGGERED — stop adding volume. ' +
             'Run `python tools/leak_finder.py brief` to re-check.' };
  }
  if (CONFIG.REQUIRE_HUMAN_CONFIRM) {
    return { ok: false, reason: 'REQUIRE_HUMAN_CONFIRM is true — Gate G4: the operator sends.' };
  }
  var hour = parseInt(Utilities.formatDate(new Date(), CONFIG.TIMEZONE, 'H'), 10);
  if (hour < CONFIG.SEND_WINDOW_START_HOUR || hour >= CONFIG.SEND_WINDOW_END_HOUR) {
    return { ok: false, reason: 'outside the ' + CONFIG.SEND_WINDOW_START_HOUR + ':00-' +
             CONFIG.SEND_WINDOW_END_HOUR + ':00 EAT window (now ' + hour + ':00).' };
  }
  var remaining = MailApp.getRemainingDailyQuota();
  if (remaining - CONFIG.MIN_QUOTA_RESERVE <= 0) {
    return { ok: false, reason: 'quota reserve reached (' + remaining + ' left).' };
  }
  return { ok: true };
}

function executeWave_(maxToSend, dry) {
  var suppression = loadSuppression_();
  var live = {};
  CONFIG.LIVE_THREAD_EMAILS.forEach(function (e) { live[normalizeEmail_(e)] = true; });

  var sentToday = countSentToday_();
  var allowance = Math.min(maxToSend, CONFIG.MAX_PER_DAY - sentToday);
  if (allowance <= 0) {
    log_('Daily cap reached: ' + sentToday + '/' + CONFIG.MAX_PER_DAY);
    return { sentCount: 0, sentToday: sentToday };
  }

  var staged = getOrCreateLabel_(CONFIG.STAGED_LABEL);
  var sentLabel = getOrCreateLabel_(CONFIG.SENT_LABEL);
  var drafts = GmailApp.getDrafts();
  var byEmail = {};
  drafts.forEach(function (d) {
    var e = normalizeEmail_(d.getMessage().getTo());
    if (e) { byEmail[e] = d; }
  });

  var queue = [], blockedLog = [];
  Object.keys(WAVES).forEach(function (waveName) {
    WAVES[waveName].forEach(function (email) {
      var e = normalizeEmail_(email);
      if (live[e]) { blockedLog.push(e + ' :: LIVE conversation'); return; }
      if (suppression[e]) { blockedLog.push(e + ' :: suppressed (' + suppression[e] + ')'); return; }
      var d = byEmail[e];
      if (!d) { blockedLog.push(e + ' :: no draft found'); return; }
      queue.push({ draft: d, email: e, wave: waveName });
    });
  });

  log_('Allowlist queued: ' + queue.length + ' | blocked: ' + blockedLog.length +
       ' | allowance this run: ' + allowance + ' | sent today: ' + sentToday);
  blockedLog.forEach(function (b) { log_('  BLOCK ' + b); });

  var sentCount = 0;
  for (var i = 0; i < queue.length && sentCount < allowance; i++) {
    var entry = queue[i];
    if (dry) {
      log_('[WOULD SEND | ' + entry.wave + '] ' + entry.email);
      try { entry.draft.getMessage().getThread().addLabel(staged); } catch (err) {}
      sentCount++;
      continue;
    }
    try {
      var thread = entry.draft.getMessage().getThread();
      entry.draft.send();
      try { thread.addLabel(sentLabel); } catch (lblErr) {}
      sentCount++;
      log_('[SENT ' + sentCount + '/' + allowance + ' | ' + entry.wave + '] ' + entry.email);
      if (sentCount < allowance) { humanSleep_(); }
    } catch (sendErr) {
      // Stop the run. v4.4 logged the error and kept hammering the inbox.
      log_('ERROR sending to ' + entry.email + ': ' + sendErr.message +
           ' — ABORTING run rather than continuing.');
      break;
    }
  }

  log_('=== RUN COMPLETE: ' + (dry ? 'previewed ' : 'sent ') + sentCount +
       ' | sent today ' + (sentToday + (dry ? 0 : sentCount)) + '/' + CONFIG.MAX_PER_DAY + ' ===');
  return { sentCount: sentCount, sentToday: sentToday, blocked: blockedLog };
}

// ------------------------------------------------------------------ helpers
function loadSuppression_() {
  var out = {};
  var lines = (CONFIG.SUPPRESSION_CSV || '').split('\n');
  for (var i = 1; i < lines.length; i++) {
    var line = lines[i].replace(/^\s+|\s+$/g, '');
    if (!line) { continue; }
    var comma = line.indexOf(',');
    var email = comma === -1 ? line : line.substring(0, comma);
    var reason = comma === -1 ? 'suppressed' : line.substring(comma + 1);
    out[normalizeEmail_(email)] = reason;
  }
  return out;
}

function countSentToday_() {
  var label = GmailApp.getUserLabelByName(CONFIG.SENT_LABEL);
  if (!label) { return 0; }
  var midnight = new Date();
  midnight.setHours(0, 0, 0, 0);
  var q = 'label:' + CONFIG.SENT_LABEL.replace('/', '-') + ' after:' +
          Utilities.formatDate(midnight, CONFIG.TIMEZONE, 'yyyy/M/d');
  try {
    return GmailApp.search(q).length;
  } catch (e) {
    return 0;
  }
}

function normalizeEmail_(raw) {
  if (!raw) { return ''; }
  var m = String(raw).match(/<([^>]+)>/);
  var addr = m ? m[1] : String(raw);
  addr = addr.replace(/^\s+|\s+$/g, '').toLowerCase();
  var at = addr.indexOf('@');
  if (at === -1) { return addr; }
  var local = addr.substring(0, at).split('+')[0];
  return local + addr.substring(at);
}

function humanSleep_() {
  var span = CONFIG.MAX_SLEEP_MS - CONFIG.MIN_SLEEP_MS;
  Utilities.sleep(CONFIG.MIN_SLEEP_MS + Math.floor(Math.random() * span));
}

function getOrCreateLabel_(name) {
  var label = GmailApp.getUserLabelByName(name);
  return label || GmailApp.createLabel(name);
}

function log_(msg) {
  Logger.log(msg);
}
