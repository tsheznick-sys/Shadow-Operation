# JARVIS Cloud — Vercel + Neon + Grok+Claude (entitlement wired) — FULLY ADAPTABLE
# Copy to jarvis-app/.env.local, add same vars to Vercel Dashboard → Settings → Environment Variables
# All thresholds/niches/platforms/pricing/pages adaptable WITHOUT code change via below envs
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
# Brain — Claude primary + Grok secondary (no OPENAI fallback)
# lib/brain.ts accepts either name for the Anthropic key.
CLAUDE_API_KEY=sk-ant-xxx
ANTHROPIC_API_KEY=sk-ant-xxx
# MODELS — current as of 2026-10-31, verified against both providers' live catalogs.
#   claude-sonnet-5-5  $2/$10 per MTok   1M ctx   "best combination of speed and intelligence"
#   claude-haiku-5-5   $0.10/$0.50       1M ctx   Anthropic names classification/extraction/routing
#   claude-opus-5-5    $4/$20            1M ctx   opt-in deep/strategy lane
#   grok-4.7           $2/$6             500k ctx xAI flagship — the fallback should not be a downgrade
# Verify at any time: GET /api/brain/models (Bearer N8N_BRAIN_TOKEN) — it asks both providers what
# they actually serve and reports whether these ids are still there. Model ids rot; that endpoint
# is how you find out before a member does.
# A RETIRED id here is detected and replaced rather than allowed to 404 every request (which is
# what claude-3-5-sonnet-20241022 did for a year while the fallback faked an answer).
ANTHROPIC_MODEL=claude-sonnet-5-5        # quality lane: script, rank, reframe, chat
ANTHROPIC_MODEL_CHEAP=claude-haiku-5-5   # cheap lane: classify, extract, route
ANTHROPIC_EFFORT=                        # low|medium|high|xhigh|max — blank = per-lane default
GROK_API_KEY=xai-xxx
XAI_API_KEY=xai-xxx
XAI_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-4.7
NEXTAUTH_URL=https://your-vercel-app.vercel.app
NEXTAUTH_SECRET=random-32-chars
GMAIL_CLIENT_ID=xxx.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=xxx
GMAIL_REFRESH_TOKEN=xxx
LINEAR_API_KEY=lin_api_xxx
WHOP_API_KEY=whop_xxx
# ---- THE THREE AGENT PRODUCTS: $44 / $53 / $62 ----
# These are the ONLY product ids the agent tiers resolve from. lib/tiers.ts is the single
# source of truth; a test fails if code reads a product var that is not declared here.
WHOP_PRODUCT_CIRCLE_ID=prod_circle_xxx    # $44 Circle  — 40 runs/5h, 600/mo, vault, pods
WHOP_PRODUCT_PRO_ID=prod_pro_xxx          # $53 Pro     — 80 runs/5h, 1200/mo, polish, direct publish
WHOP_PRODUCT_TEAM_ID=prod_team_xxx        # $62 Team    — Pro x3 seats, one invoice

# ---- ONE-TIME LADDER (NOT agent subscriptions — see lib/tiers.ts LADDER) ----
WHOP_PRODUCT_FIRST_SHOT_ID=prod_shot_xxx  # $28 14 days all-access, lapses itself
WHOP_PRODUCT_LITE_ID=prod_lite_xxx        # $17 the downgrade save: free runs, no watermark
WHOP_PRODUCT_GOOD_ID=prod_good_xxx        # $35 one-time build
WHOP_PRODUCT_BETTER_ID=prod_better_xxx    # $89 one-time build
BUFFER_TOKEN=buffer_xxx
OPUSCLIP_API_KEY=opus_xxx
HIGGSFIELD_API_KEY=
HIGGSFIELD_KEY_ID=             # console.higgsfield.ai — auth is "Authorization: Key ID:SECRET", NOT Bearer
HIGGSFIELD_KEY_SECRET=         # same page, shown once
HIGGSFIELD_COST_PER_RENDER=0.10 # plan-dependent; used by the cost model, so it must be real
# Short-form final polish $0.08/clip — improves Shorts only (added back per request)
TUBEGEN_API_KEY=tubegen_xxx
WAN_T4_URL=https://your-colab-wan-t4.ngrok.io
TELEGRAM_BOT_TOKEN=xxx
SIGNAL_API=xxx
WISE_API_KEY=wise_xxx
JIVE_JARVIS_NUMBER=+25418XXXX710
CHATFUEL_TOKEN=chatfuel_xxx
MANYCHAT_API_KEY=manychat_xxx
# Social publishing master — 5 YT brands example (adaptable via PAGES_COUNT)
SOCIAL_MASTER_EMAIL=info.wolf@gmail.com
ADMIN_EMAIL=scott.abuya@gmail.com
# ===== FULLY ADAPTABLE — change these envs + redeploy, no code edit =====
# Engine provider — choose ONE primary + keep Wan fallback
ENGINE_PROVIDER=stickman_all
# Hybrid: stickman free for Shorts + TubeGen for longform per Content Guy twist
STICKMAN_REPO_URL=https://github.com/kaomei/stickman-video-director
# niches: wan | tubegen | pictory | fliki | invideo | heygen | frameloop
TUBEGEN_API_KEY=tubegen_xxx
PICTORY_API_KEY=pictory_xxx
FLIKI_API_KEY=fliki_xxx
INVIDEO_API_KEY=invideo_xxx
HEYGEN_API_KEY=heygen_xxx
STICKMAN_FREE_REPO=kaomei/stickman-video-director
# PRIMARY engine for ALL pages (longform 30m + shorts) per 2026-10-31 answer; TubeGen is fallback only
STICKMAN_RENDER_LONGFORM=true
HIGGSFIELD_POLISH_SCOPE=longform+shorts
# Monthly 14-day Growth Operator sequence (book: Shadow_Operation_Playbook.pdf)
SEQUENCE_CADENCE=monthly
SEQUENCE_DAY_1=2
FOLLOWER_GATE_IG=1000
FOLLOWER_GATE_TIKTOK=1000
LONGFORM_PUBLISH_DAYS=1,3,5
LONGFORM_RENDER_DAILY=true
THRESHOLD_DEMAND_GREEN=50
THRESHOLD_DEMAND_AMBER=25
# storage: R2 canonical (content off Drive)
STORAGE_CANONICAL=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=jarvis-content
# Cloud free: GitHub free + Vercel Hobby $0 + Neon free — assets in /assets/stickman + Drive HQ 17KpzZCm
# Niches — CSV pool Grok WF1 re-ranks 1000→top5 to Neon solo_domains
NICHES_POOL=Psychology,Dark Psychology,Marketing History,Mindset,Wolf Mindset,Consumerism,Self-Improvement,Finance Behavior
JARVIS_BRAND_VOICE=adaptive per solo_domains.brand_voice row — Vesper 20yo playful witty per role intro
# Thresholds — GREEN <THRESHOLD_RATIO_GREEN + ER THRESHOLD_ER_GREEN%+ , AMBER range
THRESHOLD_RATIO_GREEN=50
THRESHOLD_RATIO_AMBER_MAX=70
THRESHOLD_ER_GREEN=5
THRESHOLD_ER_AMBER_MIN=3
THRESHOLD_ER_AMBER_MAX=5
THRESHOLD_ER_RED_MIN=2
THRESHOLD_BUYER_POOL_MIN=3000
THRESHOLD_DEMAND_PERCENT=1
THRESHOLD_DEMAND_MIN_REPLIES=25
THRESHOLD_DM_WINDOW_HOURS=2
# Content — platforms, cadence, engine
PLATFORMS=X,IG,TikTok,YT
X_MODE=discovery only 1-2/day filler no gate no DM
BUFFER_SERIOUS_DAILY=6
BUFFER_X_DAILY=2
CONTENT_WORDS_LONGFORM=4500
CONTENT_SCRIPTS_PER_DOMAIN=6
# Paywalls — numerology_8 ladder. $28 is the only non-8 (2+8=10->1, the Leader).
# Every other price satisfies n % 9 == 8. Enforced by scripts/check_numerology.py.
WHOP_LADDER_PRICES=$28+$17+$35+$89+$44+$53+$62
TIER_FIRST_SHOT_PRICE=28
TIER_GOOD_PRICE=35
TIER_BETTER_PRICE=89
TIER_BEST_PRICE=89
TIER_CIRCLE_PRICE=44
TIER_LITE_PRICE=17
TIER_PRO_PRICE=53
TIER_TEAM_PRICE=62
TIER_SAVE_PAUSE_PRICE=8
TIER_SAVE_PRICE=17
TIER_SAVE_DISCOUNT_PCT=0
# Private A/B control — never advertised, never in the ladder
TIER_HIDDEN_TEST_PRICE=9
# Community funding — circle carries tools, then prizes, then annual fund
FUNDING_TOOLS_MONTHLY=165
FUNDING_PRIZE_TARGET=710
FUNDING_RESERVE_PCT=12.5
# Scale — 1 Page=1 YT brand (TT+IG+Shorts via same queue), count adaptable
PAGES_COUNT=5
PAGES_LABEL=YT brands
COST_MVP_MONTHLY=61
COST_SCALE_MONTHLY=189
# Crons (override vercel.json without code redeploy of json)
CRON_CHECK_REPLIES=*/15 * * * *
CRON_DAILY_BRIEF=45 5 * * *
# ChatFuel scope — IG&TikTok only per lock, YT via ManyChat
CHATFUEL_SCOPE=IG&TikTok only
# ── N8N (cloud automation) ───────────────────────────────────────────────────
# n8n has no session cookie, so it cannot call /api/jarvis. POST /api/brain is the machine door:
# Bearer <this token>. Workflows in n8n/ read it as {{ $vars.N8N_BRAIN_TOKEN }}.
N8N_BRAIN_TOKEN=                # openssl rand -hex 32. Must match the n8n Variable of the same name.
N8N_JIVE_WEBHOOK=https://your-n8n.app/webhook/jive-broadcast
# Cost: Vercel $0→$20 + Neon $0→$19 + Claude $20 + Grok $16 + R2 $5 = $61 MVP → $89 scaled | + TubeGen $29 + Buffer Team $60 = $160 5 pages (stickman $0 engine, TubeGen $29 fallback only, Higgsfield $29 longform+shorts polish) | Entitlement wired $0
# See config/adaptable.json defaults + config/n8n_workflow_variables.json + docs/FULLY_ADAPTABLE_GUIDE.md

# ============ GOOGLE OAUTH + 2FA (2026-10-31) ============
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_URL=
NEXTAUTH_SECRET=
TFA_ENABLED=true
RESEND_API_KEY=
RESEND_FROM=Jarvis <noreply@yourdomain>
# ============ AUTONOMY MATRIX (0-100 per lane, clamped to floor) ============
AUTONOMY_RESEARCH=95
AUTONOMY_RENDER=80
AUTONOMY_CLIP_POLISH=90
AUTONOMY_PUBLISH=70
AUTONOMY_DM_GREEN=75
AUTONOMY_SEQUENCE=85
AUTONOMY_RETENTION=90
AUTONOMY_MONEY=40
AUTONOMY_VOICE=60
# numerology_8: prizes $710 (7+1+0=8) -> break-even 35, recommended 44 members

# ── TRUST ENGINE (docs/TRUST_ENGINE.md) ──────────────────────────────────────
# Free at scale, never free at 1:1, paid and guaranteed at the door.
PROOF_PUBLIC=true
PROOF_LAG_HOURS=24
PROOF_INCLUDE_FAILURES=true
CHALLENGE_COHORT_SIZE=53
CHALLENGE_MIN_COMPLETION=60
CHALLENGE_DAILY_SEND=06:00
CHALLENGE_VERIFY_LINKS=true
CHALLENGE_MIN_TENURE_DAYS=14
CHALLENGE_ENTRY_FEE=0
CHALLENGE_MISMATCH_LIMIT=20

FIRST_SHOT_GUARANTEE=true
GUARANTEE_THRESHOLD=50

# ── GLOBAL LIVE LEDGER ──────────────────────────────────────────────────────
LEDGER_REFRESH_SECONDS=60
LEDGER_TOTALS_REFRESH_SECONDS=900
# Revenue is admin-only. A brand must opt itself in via ledger_brand_settings.
LEDGER_SHOW_REVENUE=false
LEDGER_ALLOW_OPT_IN=true

# ── DUAL OUTPUT (raw -> Whop, edited -> public) ─────────────────────────────
DUAL_OUTPUT=true
RAW_DESTINATION=whop
POLICY_GATE=true
# ── RELIABILITY: three separate targets, never one headline ─────────────────
RELIABILITY_TARGET_CORRECT=98
RELIABILITY_TARGET_E2E=98
RELIABILITY_MONEY_GATE=human
# ── DAILY MARKET WATCH ──────────────────────────────────────────────────────
MARKET_WATCH=true
MARKET_WATCH_ALERT=policy

# ===== REQUIRED TO RUN LIVE (added 2026-10-31, live-readiness audit) =====
# No defaults. In production a missing value is a boot failure, not a fallback.
AUTH_SECRET=                    # 32+ chars. openssl rand -hex 32. Without it the app refuses to start.
CRON_SECRET=                    # Vercel Cron sends Bearer <this>. Unset in prod = every cron returns 503.
WHOP_WEBHOOK_SECRET=            # HMAC for /api/whop/webhook. Unset = every event refused with 503.
ALLOW_MOCK_DB=false             # true only for a deliberate demo. Production without DATABASE_URL throws.
ALLOW_MOCK_BRAIN=false          # true only for a deliberate demo. Production with no model key returns a
                                # labelled [DEMO] string instead of a 503 — only if you set this on purpose.
TEAM_OWNER_PASSWORD=            # 10+ chars. Unset in prod = the owner seat is DISABLED, not guessable.
TEAM_CONTENT_PASSWORD=          # same
TEAM_SOCIAL_PASSWORD=           # same
