{
  "crons": [
    {
      "path": "/api/cron/check-replies",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/daily-brief",
      "schedule": "45 5 * * *"
    }
  ],
  "headers": [
    {
      "source": "/manifest.json",
      "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }]
    }
  ]
}
